{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meser-recovery/audio-archive/schemas/v1/speaker-project-state.schema.json",
  "title": "Immutable Speaker project state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "workflow", "draftRevision", "sourceSessionRevision", "savedAt", "payloadSchema", "payload", "sources", "stateFingerprint"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sessionId": { "$ref": "#/$defs/uuid" },
    "workflow": { "const": "speaker" },
    "draftRevision": { "type": "integer", "minimum": 1 },
    "sourceSessionRevision": { "type": "integer", "minimum": 1 },
    "savedAt": { "type": "string", "format": "date-time" },
    "payloadSchema": { "const": "speaker/v1" },
    "payload": { "$ref": "#/$defs/payload" },
    "sources": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/source" } },
    "stateFingerprint": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "trackIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
    "region": { "type": "object", "additionalProperties": false, "required": ["regionId", "startSeconds", "endSeconds"], "properties": { "regionId": { "$ref": "#/$defs/uuid" }, "startSeconds": { "type": "number", "minimum": 0 }, "endSeconds": { "type": "number", "exclusiveMinimum": 0 } } },
    "globalCuts": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/region" } },
    "trackSilences": { "type": "array", "maxItems": 10000, "items": { "type": "object", "additionalProperties": false, "required": ["regionId", "trackId", "startSeconds", "endSeconds"], "properties": { "regionId": { "$ref": "#/$defs/uuid" }, "trackId": { "$ref": "#/$defs/uuid" }, "startSeconds": { "type": "number", "minimum": 0 }, "endSeconds": { "type": "number", "exclusiveMinimum": 0 } } } },
    "trackProcessing": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "object", "additionalProperties": false, "required": ["trackId", "enhancement", "leveling", "compression"], "properties": { "trackId": { "$ref": "#/$defs/uuid" }, "enhancement": { "enum": ["off", "gentle"] }, "leveling": { "enum": ["off", "on"] }, "compression": { "enum": ["off", "light", "medium", "strong"] } } } },
    "payload": { "type": "object", "additionalProperties": false, "required": ["trackIds", "excludedTrackIds", "globalCuts", "trackSilenceRegions", "trackProcessing"], "properties": { "trackIds": { "$ref": "#/$defs/trackIds" }, "excludedTrackIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }, "globalCuts": { "$ref": "#/$defs/globalCuts" }, "trackSilenceRegions": { "$ref": "#/$defs/trackSilences" }, "trackProcessing": { "$ref": "#/$defs/trackProcessing" } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["trackId", "blobId", "ordinal", "originalName", "mediaType", "sizeBytes", "sha256"], "properties": { "trackId": { "$ref": "#/$defs/uuid" }, "blobId": { "$ref": "#/$defs/uuid" }, "ordinal": { "type": "integer", "minimum": 1, "maximum": 32 }, "originalName": { "type": "string", "minLength": 1, "maxLength": 255 }, "mediaType": { "enum": ["audio/mpeg", "audio/mp4", "audio/wav"] }, "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 524288000 }, "sha256": { "$ref": "#/$defs/sha256" } } }
  }
}
