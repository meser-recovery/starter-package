{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meser-recovery/audio-archive/schemas/v1/deletion-tombstone.schema.json",
  "title": "Permanently deleted Source Session tombstone v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "deletedAt", "lastRevision", "releaseTag", "nextVersions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "deletion_tombstone" },
    "id": { "$ref": "#/$defs/uuid" },
    "deletedAt": { "type": "string", "format": "date-time" },
    "lastRevision": { "type": "integer", "minimum": 1 },
    "releaseTag": { "type": "string", "pattern": "^audio-session-[0-9a-f-]{36}$" },
    "nextVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["announcement", "speaker"],
      "properties": {
        "announcement": { "type": "integer", "minimum": 1 },
        "speaker": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" }
  }
}
