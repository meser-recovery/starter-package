{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meser-recovery/audio-archive/schemas/v1/transaction.schema.json",
  "title": "Recoverable audio archive transaction v1",
  "oneOf": [
    { "$ref": "#/$defs/ingestion" },
    { "$ref": "#/$defs/pendingDelete" }
  ],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "base": {
      "type": "object",
      "required": ["schemaVersion", "kind", "transactionId", "idempotencyHash", "revision", "state", "sessionId", "createdAt", "updatedAt"]
    },
    "partPlan": {
      "type": "object", "additionalProperties": false, "required": ["partNumber", "sizeBytes", "sha256", "assetName"],
      "properties": {
        "partNumber": { "type": "integer", "minimum": 1, "maximum": 9999 }, "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "sha256": { "$ref": "#/$defs/sha256" }, "assetName": { "type": "string", "pattern": "^blob-[0-9a-f-]{36}-part-[0-9]{4}\\.bin$" }
      }
    },
    "trackPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["trackId", "blobId", "ordinal", "originalName", "mediaType", "sizeBytes", "sha256", "parts"],
      "properties": {
        "trackId": { "$ref": "#/$defs/uuid" }, "blobId": { "$ref": "#/$defs/uuid" }, "ordinal": { "type": "integer", "minimum": 1 },
        "originalName": { "type": "string", "minLength": 1, "maxLength": 255 }, "mediaType": { "enum": ["audio/mpeg", "audio/mp4", "audio/wav"] },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 524288000 }, "sha256": { "$ref": "#/$defs/sha256" },
        "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/partPlan" } }
      }
    },
    "uploadedPart": {
      "type": "object", "additionalProperties": false,
      "required": ["blobId", "partNumber", "assetName", "sizeBytes", "sha256", "assetId", "downloadUrl"],
      "properties": {
        "blobId": { "$ref": "#/$defs/uuid" }, "partNumber": { "type": "integer", "minimum": 1 }, "assetName": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "assetId": { "type": "integer", "minimum": 1 },
        "downloadUrl": { "type": "string", "format": "uri" }
      }
    },
    "ingestion": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "transactionId", "idempotencyHash", "revision", "state", "sessionId", "releaseId", "releaseTag", "title", "recordedAt", "origin", "supersedesSessionId", "plan", "uploadedParts", "stagedManifest", "createdAt", "updatedAt"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "ingestion" }, "transactionId": { "$ref": "#/$defs/uuid" },
        "idempotencyHash": { "$ref": "#/$defs/sha256" }, "revision": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["uploading", "staged", "finalized", "discarded"] }, "sessionId": { "$ref": "#/$defs/uuid" },
        "releaseId": { "type": "integer", "minimum": 1 }, "releaseTag": { "type": "string", "pattern": "^audio-session-[0-9a-f-]{36}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 }, "recordedAt": { "type": ["string", "null"], "format": "date-time" },
        "origin": { "enum": ["manual", "device"] }, "supersedesSessionId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "plan": { "type": "object", "additionalProperties": false, "required": ["totalBytes", "tracks"], "properties": { "totalBytes": { "type": "integer", "minimum": 1, "maximum": 524288000 }, "tracks": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/trackPlan" } } } },
        "uploadedParts": { "type": "array", "items": { "$ref": "#/$defs/uploadedPart" } }, "stagedManifest": { "type": ["object", "null"] },
        "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "deleteAction": {
      "type": "object", "required": ["kind"],
      "oneOf": [
        { "additionalProperties": false, "properties": { "kind": { "const": "output-version" }, "workflow": { "enum": ["announcement", "speaker"] }, "version": { "type": "integer", "minimum": 1 } }, "required": ["kind", "workflow", "version"] },
        { "additionalProperties": false, "properties": { "kind": { "const": "output-series" }, "workflow": { "enum": ["announcement", "speaker"] } }, "required": ["kind", "workflow"] },
        { "additionalProperties": false, "properties": { "kind": { "enum": ["sources", "purge"] } }, "required": ["kind"] }
      ]
    },
    "pendingDelete": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "transactionId", "idempotencyHash", "revision", "state", "sessionId", "expectedRevision", "releaseId", "releaseTag", "action", "assetIds", "deletedAssetIds", "createdAt", "updatedAt"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "pending_delete" }, "transactionId": { "$ref": "#/$defs/uuid" }, "idempotencyHash": { "$ref": "#/$defs/sha256" },
        "revision": { "type": "integer", "minimum": 1 }, "state": { "enum": ["pending_delete", "complete"] }, "sessionId": { "$ref": "#/$defs/uuid" },
        "expectedRevision": { "type": "integer", "minimum": 1 }, "releaseId": { "type": "integer", "minimum": 1 }, "releaseTag": { "type": "string", "pattern": "^audio-session-[0-9a-f-]{36}$" },
        "action": { "$ref": "#/$defs/deleteAction" }, "assetIds": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
        "deletedAssetIds": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
        "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
