{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meser-recovery/audio-archive/schemas/v1/archive-settings.schema.json",
  "title": "S12 decrypted settings v1; plaintext is server memory only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "revision",
    "lastMutationId",
    "activeConnectionId",
    "connections",
    "storage"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lastMutationId": {
      "oneOf": [
        {
          "$ref": "transaction.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "activeConnectionId": {
      "oneOf": [
        {
          "$ref": "transaction.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connectionId",
          "name",
          "accountId",
          "clientId",
          "clientSecret",
          "meetingId",
          "revision",
          "verification"
        ],
        "properties": {
          "connectionId": {
            "$ref": "transaction.schema.json#/$defs/uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "accountId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "clientId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "clientSecret": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "meetingId": {
            "type": "string",
            "pattern": "^[0-9]{9,11}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "verification": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fingerprint",
                  "checkedAt",
                  "tracks"
                ],
                "properties": {
                  "fingerprint": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "checkedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "tracks": {
                    "enum": [
                      "confirmed",
                      "unconfirmed"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "maxItems": 32
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "softLimitBytes",
        "warningPercent"
      ],
      "properties": {
        "softLimitBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "warningPercent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    }
  },
  "$comment": "Runtime additionally requires unique connection IDs, an active verified connection, and a verification fingerprint bound to exact credentials/meeting."
}
