{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meser-recovery/audio-archive/schemas/v1/source-session.schema.json",
  "title": "Source Session manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "id", "title", "recordedAt", "createdAt", "updatedAt", "origin", "storage", "lifecycle", "sourceState", "sourceTracks", "deletedSources", "workflows", "relations", "transaction"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "id": { "$ref": "#/$defs/uuid" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "recordedAt": { "type": ["string", "null"], "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "origin": {
      "type": "object", "additionalProperties": false, "required": ["kind", "externalId"],
      "properties": { "kind": { "enum": ["manual", "device", "zoom_webhook"] }, "externalId": { "type": ["string", "null"] } }
    },
    "storage": {
      "type": "object", "additionalProperties": false, "required": ["releaseId", "tag"],
      "properties": { "releaseId": { "type": "integer", "minimum": 1 }, "tag": { "type": "string", "pattern": "^audio-session-[0-9a-f-]{36}$" } }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false, "required": ["state"],
      "properties": { "state": { "enum": ["incoming", "archived"] } }
    },
    "sourceState": { "enum": ["available", "deleted"] },
    "sourceTracks": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/blob" } },
    "deletedSources": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false, "required": ["deletedAt", "tracks"],
          "properties": {
            "deletedAt": { "type": "string", "format": "date-time" },
            "tracks": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/deletedTrack" } }
          }
        }
      ]
    },
    "workflows": {
      "type": "object", "additionalProperties": false, "required": ["announcement", "speaker"],
      "properties": {
        "announcement": { "$ref": "#/$defs/workflow" },
        "speaker": { "$ref": "#/$defs/workflow" }
      }
    },
    "relations": {
      "type": "object", "additionalProperties": false, "required": ["supersedesSessionId", "supersededBySessionId"],
      "properties": { "supersedesSessionId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] }, "supersededBySessionId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] } }
    },
    "transaction": {
      "type": "object", "additionalProperties": false, "required": ["state", "id"],
      "properties": { "state": { "const": "finalized" }, "id": { "$ref": "#/$defs/uuid" } }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "sourceState": { "const": "available" } }, "required": ["sourceState"] },
      "then": {
        "properties": {
          "sourceTracks": { "minItems": 1 },
          "deletedSources": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "sourceState": { "const": "deleted" } }, "required": ["sourceState"] },
      "then": {
        "properties": {
          "sourceTracks": { "maxItems": 0 },
          "deletedSources": { "type": "object" }
        }
      }
    }
  ],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "part": {
      "type": "object", "additionalProperties": false,
      "required": ["partNumber", "sizeBytes", "sha256", "assetName", "assetId", "downloadUrl"],
      "properties": {
        "partNumber": { "type": "integer", "minimum": 1, "maximum": 9999 },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "assetName": { "type": "string", "pattern": "^blob-[0-9a-f-]{36}-part-[0-9]{4}\\.bin$" },
        "assetId": { "type": "integer", "minimum": 1 },
        "downloadUrl": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/meser-recovery/audio-archive/releases/download/" }
      }
    },
    "blob": {
      "type": "object", "additionalProperties": false,
      "required": ["trackId", "blobId", "ordinal", "originalName", "mediaType", "sizeBytes", "sha256", "parts"],
      "properties": {
        "trackId": { "$ref": "#/$defs/uuid" }, "blobId": { "$ref": "#/$defs/uuid" },
        "ordinal": { "type": "integer", "minimum": 1 }, "originalName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "mediaType": { "enum": ["audio/mpeg", "audio/mp4", "audio/wav"] },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 524288000 }, "sha256": { "$ref": "#/$defs/sha256" },
        "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/part" } }
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["outputId", "version", "sessionId", "createdAt", "blobId", "sizeBytes", "sha256", "parts", "recipeSnapshotRef", "processorVersion"],
      "properties": {
        "outputId": { "$ref": "#/$defs/uuid" }, "version": { "type": "integer", "minimum": 1 }, "sessionId": { "$ref": "#/$defs/uuid" },
        "createdAt": { "type": "string", "format": "date-time" }, "blobId": { "$ref": "#/$defs/uuid" },
        "sizeBytes": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha256" },
        "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/part" } },
        "recipeSnapshotRef": { "type": "string", "minLength": 1 }, "processorVersion": { "type": "string", "minLength": 1 }
      }
    },
    "deletedTrack": {
      "type": "object", "additionalProperties": false,
      "required": ["trackId", "blobId", "sizeBytes", "sha256"],
      "properties": {
        "trackId": { "$ref": "#/$defs/uuid" }, "blobId": { "$ref": "#/$defs/uuid" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 524288000 }, "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "draftReference": {
      "type": "object", "additionalProperties": false, "required": ["path", "revision"],
      "properties": {
        "path": { "type": "string", "pattern": "^drafts/[0-9a-f-]{36}/(announcement|speaker)\\.json$" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow", "status", "currentDraft", "outputs", "deletedVersions", "nextVersion"],
      "properties": {
        "workflow": { "enum": ["announcement", "speaker"] }, "status": { "enum": ["new", "in_progress", "result_ready"] },
        "currentDraft": { "oneOf": [{ "$ref": "#/$defs/draftReference" }, { "type": "null" }] }, "outputs": { "type": "array", "items": { "$ref": "#/$defs/output" } },
        "deletedVersions": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
        "nextVersion": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
