{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S11 approved audio block specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tutorial", "narration", "review_policy", "scenes", "narration_modules"],
  "properties": {
    "schema_version": {"const": 2},
    "tutorial": {
      "type": "object", "additionalProperties": false,
      "required": ["language", "canonical_content"],
      "properties": {
        "language": {"const": "ru-RU"},
        "canonical_content": {
          "type": "object", "additionalProperties": false,
          "required": ["source", "sha256", "policy"],
          "properties": {
            "source": {"const": "content/meser-audio-tutorial-canonical-content-pack.md"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "policy": {"const": "fail_on_content_drift"}
          }
        }
      }
    },
    "narration": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "voice_id", "model_id", "output_format", "voice_settings", "pronunciation", "language_code", "delivery_prefix"],
      "properties": {
        "provider": {"const": "elevenlabs"},
        "voice_id": {"const": "LHi3adMlU7AICv8Yxpmm"},
        "model_id": {"const": "eleven_v3"},
        "output_format": {"const": "mp3_44100_128"},
        "voice_settings": {
          "type": "object", "additionalProperties": false,
          "required": ["stability"], "properties": {"stability": {"const": 0.5}}
        },
        "pronunciation": {"type": "object", "additionalProperties": false, "properties": {}},
        "language_code": {"const": "ru"},
        "delivery_prefix": {"const": "[calm] [conversational]"}
      }
    },
    "review_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["first_audio_block", "block_order", "require_previous_block_approval", "final_requires_all_block_approvals"],
      "properties": {
        "first_audio_block": {"const": "B01"},
        "block_order": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"type": "string", "pattern": "^B(0[1-9]|1[0-4])$"}},
        "require_previous_block_approval": {"const": true},
        "final_requires_all_block_approvals": {"const": true}
      }
    },
    "scenes": {"type": "array", "minItems": 54, "maxItems": 54, "items": {"$ref": "#/$defs/scene"}},
    "narration_modules": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/block"}}
  },
  "$defs": {
    "scene": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "block_id", "number", "goal", "start_offset", "end_offset", "narration", "captions"],
      "properties": {
        "id": {"type": "string", "pattern": "^B(0[1-9]|1[0-4])-[0-9]{3}$"},
        "block_id": {"type": "string", "pattern": "^B(0[1-9]|1[0-4])$"},
        "number": {"type": "number", "minimum": 1},
        "goal": {"type": "string", "minLength": 1},
        "start_offset": {"type": "number", "minimum": 0},
        "end_offset": {"type": "number", "minimum": 1},
        "narration": {"type": "string", "minLength": 1},
        "captions": {"type": "array", "maxItems": 0, "items": {"type": "string"}}
      }
    },
    "block": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "canonical_start_offset", "canonical_end_offset", "scene_ids", "narration", "pronunciation_dictionary_locators"],
      "properties": {
        "id": {"type": "string", "pattern": "^B(0[1-9]|1[0-4])$"},
        "title": {"type": "string", "minLength": 1},
        "canonical_start_offset": {"type": "number", "minimum": 0},
        "canonical_end_offset": {"type": "number", "minimum": 1},
        "scene_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^B(0[1-9]|1[0-4])-[0-9]{3}$"}},
        "narration": {"type": "string", "minLength": 1},
        "pronunciation_dictionary_locators": {"type": "array", "maxItems": 3, "items": {"type": "object"}},
        "tts": {
          "type": "object", "additionalProperties": false,
          "required": ["opening_tag", "pauses"],
          "properties": {
            "opening_tag": {"type": "string", "const": "[slowly]"},
            "pauses": {"type": "array", "minItems": 1, "items": {
              "type": "object", "additionalProperties": false,
              "required": ["after_offset", "reason"],
              "properties": {
                "after_offset": {"type": "number", "minimum": 1},
                "reason": {"type": "string", "minLength": 1}
              }
            }}
          }
        }
      }
    }
  }
}
